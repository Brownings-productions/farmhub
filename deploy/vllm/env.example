# Copy to deploy/vllm/.env (gitignored) and edit. `./vllm.sh config` shows the result.
#
# Named without a leading dot on purpose: .gitignore excludes .env.* so that no real
# secret is ever committed, and this file has to stay tracked.
#
# This file IS the model profile for the inference backend. The matching FarmHub-side
# profile in config/farmhub.toml must name the same model, revision and kv_cache_dtype,
# and its weights_gb / kv_cache_gb come from an evals run (SPEC §2) — not from guesswork.

# --- image ------------------------------------------------------------------------
# Pinned, not :latest. The NVFP4 kernel path on this card depends on the vLLM version,
# so an unpinned image would change which kernel gets selected under you.
# v0.29.0 is the first release at or above the 0.28.0 the RTX 5090 NVFP4 recipe needs.
VLLM_IMAGE_TAG=v0.29.0

# --- where the checkpoints live ---------------------------------------------------
# Must be inside the Linux filesystem. Never /mnt/c or /mnt/d: the Windows file bridge
# is far too slow for a 20 GB checkpoint. Budget against C:, not against what `df`
# reports for the WSL virtual disk, and prune between evaluation runs.
HF_CACHE_DIR=/home/henber/.cache/huggingface

# Only needed for gated repositories. Never commit a real token.
HUGGING_FACE_HUB_TOKEN=

# --- model profile ----------------------------------------------------------------
# SPEC §2: every profile pins a revision, and a tag or branch is NOT a pin. One NVFP4
# upload of this model was silently replaced on 2026-07-10 with weights that loop.
# Resolve the sha for a repo with:
#   ./vllm.sh resolve nvidia/Qwen3.6-35B-A3B-NVFP4
#
# The sha below is what main pointed at on 2026-09-20. Re-resolve before trusting it,
# and if it has moved, find out what changed before following it.
#
# The other M1 candidates, resolved the same day (SPEC §2):
#   Qwen/Qwen3.6-35B-A3B                        995ad96eacd98c81ed38be0c5b274b04031597b0
#   stelterlab/Qwen3-30B-A3B-Instruct-2507-AWQ  d1a5d0d183a72483152c37ebdb88d4a015a3c8ea
#   Qwen/Qwen3-30B-A3B-Instruct-2507            0d7cf23991f47feeb3a57ecb4c9cee8ea4a17bfe
#   mistralai/Mistral-Small-3.2-24B-Instruct-2506  95a6d26c4bfb886c58daf9d3f7332c857cb27b43
VLLM_MODEL=nvidia/Qwen3.6-35B-A3B-NVFP4
VLLM_REVISION=1355db6a052410cfd62085d94b58866fd0f2c3c5

# What the model calls itself over the API. FarmHub's llm.model must match this.
VLLM_SERVED_MODEL_NAME=farmhub-primary

# modelopt_fp4 for the NVFP4 checkpoints, awq or gptq_marlin for the 4-bit ones.
VLLM_QUANTIZATION=modelopt_fp4

# SPEC §2: declared and evaluated, never assumed. "auto" is the backend default;
# "fp8" buys memory and may cost part-number fidelity on this architecture. M1
# measures both before either is trusted.
VLLM_KV_CACHE_DTYPE=auto

# From the evals run, not from hope. The RTX 5090's 32 GB caps this model near 64K
# BEFORE any auxiliary reservation, and the single-GPU profile must also leave room
# for Whisper, BGE-M3 and the reranker.
VLLM_MAX_MODEL_LEN=32768

# Must leave at least aux_reserve_gb of the card free (SPEC §2). vLLM starts before
# the auxiliary models, so this fraction is taken against a known-free card.
VLLM_GPU_MEMORY_UTILIZATION=0.82

# The NVFP4 recipe for this card requires 128. The default elsewhere is 16.
VLLM_BLOCK_SIZE=128

# SPEC §1 serves 2-3 concurrent voice users; a little headroom above that.
VLLM_MAX_NUM_SEQS=8

# Parser for the model's tool-call format. A wrong value means tool calls silently
# arrive as plain text, so verify it against the model card.
VLLM_TOOL_CALL_PARSER=hermes

# --- everything model-specific that does not deserve its own variable -------------
# Text-only flags for a multimodal checkpoint go here (SPEC §2: FarmHub has no
# multimodal path and the vision tower's memory is memory the KV cache needs).
VLLM_EXTRA_ARGS=

# --- WSL2 (dev PC only) -----------------------------------------------------------
# vLLM turns pinned host memory off under WSL unless this is 1, and v0.29.0's model
# runner then refuses to start with "UVA is not available". Supported upstream for
# WSL2 kernels >= 4.19.121. Has no effect on native Linux: leave it at 0 on hub.
VLLM_WSL2_ENABLE_PIN_MEMORY=1

# --- listener ---------------------------------------------------------------------
# vLLM has no authentication. Keep it on loopback on every host.
VLLM_BIND_HOST=127.0.0.1
VLLM_PORT=8000

# Loading a 30B checkpoint from a cold cache takes a while; health failures before
# this elapses do not mark the container unhealthy.
VLLM_START_PERIOD=900s
